# Copy to .env.local and fill in. .env.local is git-ignored.

# Postgres connection string. In production (Vercel) use the *pooled* URL — Supabase's
# transaction pooler (port 6543) or Neon's "-pooler" host — because every serverless instance
# opens its own connections.
# Keep `?sslmode=require`: postgres.js does not turn on TLS by itself, and hosted Postgres refuses
# unencrypted connections (Supabase/Neon dashboard strings often omit it — append it).
# If the password contains @ : / or ?, percent-encode it (@ becomes %40).
DATABASE_URL="postgresql://user:password@host:6543/postgres?sslmode=require"

# Only used by `pnpm db:push`. DDL through the transaction pooler is unreliable, and Supabase's
# direct host (db.<ref>.supabase.co) is IPv6-only unless you pay for the IPv4 add-on — so use the
# *session* pooler (same pooler host as above, but port 5432).
DIRECT_URL="postgresql://user:password@host:5432/postgres?sslmode=require"

# Supabase Auth holds the passwords (and sends the reset e-mails); the app keeps roles and sessions.
# Project Settings → API. SUPABASE_SECRET_KEY (the sb_secret_… key) is a secret: server only, never NEXT_PUBLIC_.
# Also add <your-site>/reset-password under Authentication → URL Configuration → Redirect URLs.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# Leave unset in production: cookies are Secure whenever NODE_ENV=production.
# Set to "false" only to try a production build over plain http://localhost.
# COOKIE_SECURE=false

# Only read by `pnpm db:seed`, and only when the first administrator is created.
# If SEED_ADMIN_PASSWORD is not set a random password is printed once.
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="change-me-after-first-sign-in"
